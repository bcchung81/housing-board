{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_documents.schema.json",
  "title": "ledger/source_documents",
  "description": "원천 문서 목록(정책→입주 원천 수집 파이프라인 P9 출력). 문서 1개 = 1행: 파일이 있으면 sha256 이 같은 것은 한 행(다른 URL 은 url_aliases), 파일이 없으면 canonical_url 이 같은 것은 한 행. 설계 docs/speech/research/파이프라인_설계.md 5.1. 운영 원장(Supabase)에는 싣지 않는 연구 표.",
  "type": "object",
  "required": [
    "schema_version",
    "table",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ledger/1"
    },
    "table": {
      "const": "source_documents"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "doc_id",
        "canonical_url",
        "url_aliases",
        "title",
        "doc_type",
        "format",
        "publisher_org",
        "publisher_dept",
        "host_org",
        "published_at",
        "collected_at",
        "collection_method",
        "local_path",
        "sha256",
        "bytes",
        "parent_doc_id",
        "stage_codes",
        "saved",
        "not_saved_reason",
        "source_ref",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string",
          "pattern": "^(DOC|URL)-[0-9a-f]{16}$",
          "description": "DOC-<sha256 앞 16자>(파일 있음) · URL-<sha256(canonical_url) 앞 16자>(파일 없음)"
        },
        "canonical_url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "정규화 URL(tools/research/chain/config/url_rules.json). 로컬에서만 온 파일이거나 같은 URL 이 다른 내용을 돌려주면 null"
        },
        "url_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "같은 내용의 다른 URL(전재·재게시)과 정규화 전 원래 URL"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "문서 제목 또는 파일명"
        },
        "doc_type": {
          "enum": [
            "PRESS_RELEASE",
            "AGENDA",
            "BRIEFING",
            "CLARIFICATION",
            "GOSI",
            "RECRUIT_NOTICE",
            "NOTICE_ATTACHMENT",
            "PLAN_LIST",
            "API_RESPONSE",
            "DATA_FILE",
            "WEB_PAGE",
            "REPORT",
            "OTHER"
          ],
          "description": "NOTICE_ATTACHMENT = 모집공고의 공고문 외 첨부(평면도·카탈로그·배치도·서식 등)"
        },
        "format": {
          "enum": [
            "PDF",
            "HWPX",
            "HWP",
            "HTML",
            "JSON",
            "JSONL_GZ",
            "CSV",
            "XLS",
            "XLSX",
            "ZIP",
            "DOCX",
            "TXT",
            "OTHER"
          ]
        },
        "publisher_org": {
          "type": "string",
          "minLength": 1,
          "description": "발행(작성) 기관. 빈칸 금지(모르면 도메인 운영 기관, notes 에 '도메인 추정')"
        },
        "publisher_dept": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "담당 부서(원문·manifest·게시판 표기). 없으면 null. 공무원 개인 이름·전화번호 금지"
        },
        "host_org": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "게시 사이트 운영 기관(재게시처)"
        },
        "published_at": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ],
          "description": "원문 게시·고시일"
        },
        "collected_at": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/datetime"
            },
            {
              "$ref": "common.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ],
          "description": "받은 시각(날짜만 남은 기록은 날짜, 받지 않았으면 null)"
        },
        "collection_method": {
          "enum": [
            "EXA_SEARCH",
            "EXA_CONTENTS",
            "EGO_LITE",
            "HTTP",
            "API",
            "REPO_RAW",
            "HOME_DUMP"
          ]
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "저장소 상대 경로(같은 파일이 여러 곳이면 대표 하나, 나머지는 notes)"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_doc_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(DOC|URL)-[0-9a-f]{16}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "첨부의 게시물 문서"
        },
        "stage_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/stage_code"
          },
          "description": "쓰인 단계(정렬·중복 없음)"
        },
        "saved": {
          "type": "boolean",
          "description": "원 파일 보존 여부"
        },
        "not_saved_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref": {
          "$ref": "common.schema.json#/$defs/source_ref"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "'도메인 추정'(발행기관을 원문이 아니라 도메인으로 채움), 같은 파일의 다른 저장 경로 등"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "saved": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "local_path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "bytes": {
                "type": "integer"
              },
              "not_saved_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "local_path": {
                "type": "null"
              },
              "sha256": {
                "type": "null"
              },
              "bytes": {
                "type": "null"
              },
              "not_saved_reason": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}

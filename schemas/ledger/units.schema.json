{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "units.schema.json",
  "title": "ledger/units",
  "description": "공급 물량. 기준이 다른 물량(준공예정·공고·공사규모·허가·기관 계획)은 서로 더하지 않는다. 같은 사업의 공급유형은 유형별 행(SUBTYPE), 사업 전체는 TOTAL. 공통규격 v1.4: 공급물량_units.csv + complex_id. PERMIT(건축HUB 허가 세대수)·AGENCY_PLAN(기관 입력 계획 호수)은 확장 값이다.",
  "type": "object",
  "required": [
    "schema_version",
    "table",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ledger/1"
    },
    "table": {
      "const": "units"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "local_project_id",
        "complex_id",
        "quantity_type",
        "housing_type",
        "unit_count",
        "reference_period",
        "unit_scope",
        "source_ref",
        "review_status"
      ],
      "additionalProperties": false,
      "properties": {
        "local_project_id": {
          "$ref": "common.schema.json#/$defs/project_id"
        },
        "complex_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/complex_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "quantity_type": {
          "enum": [
            "PUBLIC_PLAN",
            "NOTICE",
            "PROJECT_PLAN",
            "PERMIT",
            "AGENCY_PLAN"
          ]
        },
        "housing_type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "unit_count": {
          "type": "integer",
          "minimum": 0
        },
        "reference_period": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit_scope": {
          "enum": [
            "SUBTYPE",
            "TOTAL"
          ]
        },
        "source_ref": {
          "$ref": "common.schema.json#/$defs/source_ref"
        },
        "review_status": {
          "$ref": "common.schema.json#/$defs/review_status"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projects.schema.json",
  "title": "ledger/projects",
  "description": "사업 원장. 사업 id 하나 = 사업 하나. 지역·기관·단계는 코드로만 두고 이름은 areas·agencies 에서 얻는다. issued_at 이 null 이면 아직 발급하지 않은 후보(변환 미리보기)다. 보관(월 배치). 공통규격 v1.4: 사업_projects.csv. region·sigungu·organization·project_status 글자 칸 대신 sgg_code·agency_id·stage_code 코드를 둔다(v1.4 보완 제안 3), public_basis 는 보완 제안 4.",
  "type": "object",
  "required": [
    "schema_version",
    "table",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ledger/1"
    },
    "table": {
      "const": "projects"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "local_project_id",
        "project_name",
        "project_unit",
        "sgg_code",
        "agency_id",
        "public_scope",
        "public_basis",
        "stage_code",
        "as_of",
        "issued_at",
        "superseded_by",
        "source_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "local_project_id": {
          "$ref": "common.schema.json#/$defs/project_id"
        },
        "project_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "project_unit": {
          "enum": [
            "PROJECT",
            "BLOCK",
            "AREA_UNKNOWN"
          ],
          "description": "PROJECT 번지 단위 사업(건축HUB) · BLOCK 단지·블록 · AREA_UNKNOWN 블록명이 번호뿐"
        },
        "sgg_code": {
          "$ref": "common.schema.json#/$defs/sgg"
        },
        "agency_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/agency_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "public_scope": {
          "enum": [
            "PUBLIC",
            "PRIVATE_ON_PUBLIC_LAND",
            "UNKNOWN"
          ]
        },
        "public_basis": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "stage_code": {
          "$ref": "common.schema.json#/$defs/stage_code"
        },
        "as_of": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "issued_at": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "superseded_by": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/project_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref": {
          "$ref": "common.schema.json#/$defs/source_ref"
        }
      }
    }
  }
}

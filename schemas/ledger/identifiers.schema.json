{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identifiers.schema.json",
  "title": "ledger/identifiers",
  "description": "외부 식별자(원천 레코드 ↔ 사업). 원천 자료는 이 표의 (id_type, id_value) 로 사업에 붙는다. 값은 문자열(관리번호 6·7·13·22자리, 앞자리 0). 필지·법정동은 project_locations 에 둔다. 공통규격 v1.4: 사업식별자_identifiers.csv + as_of. HUB_HS_PK·HUB_AP_PK·MANUAL·BLDRGST_PK(건축물대장)·REB_COMPLEX_ID(부동산원 단지)·KAPT_CODE(K-apt 단지)·MYHOME_HSMP_SN(마이홈 단지)·HOME(HOME 덤프 별칭 HPR_·PRO_·LH_ — 원래 MANUAL 에 섞여 있었다)은 확장 값이고 match_rule(자동 연결 규칙)은 확장 열이다(v1.4 는 PNU·BJD_CODE·INTERNAL_PROJECT_ID 도 여기 두지만 원장에서는 각각 project_locations·기본 키다).",
  "type": "object",
  "required": [
    "schema_version",
    "table",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ledger/1"
    },
    "table": {
      "const": "identifiers"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "local_project_id",
        "id_type",
        "id_value",
        "id_issuer",
        "as_of",
        "source_ref",
        "match_status",
        "match_rule"
      ],
      "additionalProperties": false,
      "properties": {
        "local_project_id": {
          "$ref": "common.schema.json#/$defs/project_id"
        },
        "id_type": {
          "enum": [
            "AREA_BLOCK",
            "BUNDLE_ID",
            "LH_AREA_BLOCK_CODE",
            "HUB_HS_PK",
            "HUB_AP_PK",
            "MANUAL",
            "BLDRGST_PK",
            "REB_COMPLEX_ID",
            "KAPT_CODE",
            "MYHOME_HSMP_SN",
            "HOME"
          ]
        },
        "id_value": {
          "type": "string",
          "minLength": 1
        },
        "id_issuer": {
          "enum": [
            "LH",
            "HOUSING_WAVE",
            "국토교통부",
            "행정안전부",
            "한국부동산원"
          ]
        },
        "as_of": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref": {
          "$ref": "common.schema.json#/$defs/source_ref"
        },
        "match_status": {
          "$ref": "common.schema.json#/$defs/review_status"
        },
        "match_rule": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$",
              "description": "원천 레코드를 사업에 붙인 자동 연결 규칙 이름(tools/ledger/stage-link.js RULE, LH 블록 ↔ 건축HUB 는 LH_BLOCK_DISTRICT)"
            },
            {
              "type": "null",
              "description": "키 그대로(레지스트리·원천이 준 사업 키)"
            }
          ]
        }
      }
    }
  }
}

 "judge_rules_note": "사이트 판단(필요/참고/범위 밖). 위에서부터 처음 맞는 규칙. when 의 조건 중 하나라도 맞으면 맞음(OR), all 은 모두(AND). field: route(수집 경로·형식), name(공식 원천명), units(관리표 행의 연결 가능 단위, 행이 없으면 원천명), name_units(둘 다). flag: internal·all_coop(모든 행이 협조 요청)·portal.",
 "judge_rules": [
  {
   "verdict": "범위 밖",
   "why": "기관 내부·협조 요청 자료(공개 원천 아님)",
   "when": [
    {
     "flag": "internal"
    },
    {
     "flag": "all_coop"
    }
   ]
  },
  {
   "verdict": "범위 밖",
   "why": "기반시설·수요 지표 — 정책→입주 단계 사실이 아님(지도 기반시설 화면 원천)",
   "when": [
    {
     "field": "name",
     "regex": "학교|학구|어린이집|보육|생활SOC|에너지|청약통장"
    }
   ]
  },
  {
   "verdict": "참고",
   "why": "검색 창구(포털) — 개별 데이터셋은 그 번호의 행·관리표 미수록 행에서 대조",
   "when": [
    {
     "flag": "portal"
    }
   ]
  },
  {
   "verdict": "참고",
   "why": "법령·제도 — 단계 사실 판정의 근거 조항, 사업 값 아님",
   "when": [
    {
     "field": "name_units",
     "regex": "법령|입법|법제처"
    }
   ]
  },
  {
   "verdict": "참고",
   "why": "재정·조달·금융 — 사업 단계 사실 보강 후보(사업 키로 바로 잇지 못함)",
   "when": [
    {
     "field": "name_units",
     "regex": "예산|재정|재원|리츠|조달|입찰|계약|나라장터"
    }
   ]
  },
  {
   "verdict": "참고",
   "why": "공급 결과 지표 — 단계 사실(공고일·입주일)이 아님",
   "when": [
    {
     "field": "name",
     "regex": "경쟁률|가점"
    }
   ]
  },
  {
   "verdict": "필요",
   "why": "정책 원문(01) — 목표·프로그램·지명의 원문 근거",
   "when": [
    {
     "all": [
      {
       "field": "units",
       "regex": "정책|발표|문서"
      },
      {
       "field": "route",
       "regex": "PDF|HWP|웹"
      }
     ]
    }
   ]
  },
  {
   "verdict": "필요",
   "why": "사업 단위 단계 사실(02~06)의 원천 — 사업 키로 이을 수 있음",
   "when": [
    {
     "field": "units",
     "regex": "사업|지구|블록|필지|대지|허가|승인|고시|인가|공고|단지|구역|공구|건물|심의|원천파일"
    }
   ]
  },
  {
   "verdict": "참고",
   "why": "집계 통계 — 사업 단위로 잇지 못함, 총량 대조용",
   "when": [
    {
     "field": "units",
     "regex": "통계|집계|지역|격자"
    }
   ]
  },
  {
   "verdict": "참고",
   "why": "단위 미상 — 자료별 확인 필요",
   "when": [
    {
     "always": true
    }
   ]
  }
 ],

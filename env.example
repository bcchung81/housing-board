# .env.local 견본 — 이 파일을 .env.local 로 복사해 값을 채운다(.env.local 은 gitignore, 값은 어디에도 올리지 않는다).
# 키 값은 공공데이터포털 '마이페이지 > 개발계정 > 일반 인증키'의 "디코딩" 값을 그대로 붙여 넣는다(+ / = 가 들어 있어도 됨, 요청할 때 한 번만 인코딩).
# 이름 규칙·고르는 방법·한도: lib/keys.js 머리말, 정본 문서: docs/product/상황판-스펙.md

# --- 용도별 키: DATA_GO_KR_KEY_<용도>_<번호> ---------------------------------
# 용도  BUILD   번들·색인 만들 때(tools/regiontools). 한도에 닿으면 다음 번호 키로 이어서 부른다
#       RESOLVE 표준코드 해석(/api/v1/resolve)
#       BUS     버스 위치 조회(/api/bus, 사용자가 버튼을 누를 때만)
#       DEMO    시연용(DATA_GO_KR_PROFILE=demo 일 때 BUS·RESOLVE 가 먼저 쓴다)
# 같은 용도의 키가 여러 개면 오늘 가장 적게 쓴 키부터 쓰고, 한도 오류를 받은 키는 한국시간 자정까지 쉰다.
DATA_GO_KR_KEY_BUILD_1=
DATA_GO_KR_KEY_BUILD_2=
DATA_GO_KR_KEY_RESOLVE_1=
DATA_GO_KR_KEY_BUS_1=
DATA_GO_KR_KEY_BUS_2=
DATA_GO_KR_KEY_DEMO_1=
DATA_GO_KR_KEY_DEMO_2=

# (선택) 그 키로 활용신청한 서비스. 쓰지 않으면 모든 서비스에 쓸 수 있다고 본다
#DATA_GO_KR_SERVICES_BUS_1=tago
#DATA_GO_KR_SERVICES_BUILD_1=hub,stan,myhome

# (선택) 서비스별 일일 한도 재정의. 기본: tago=10000, seoul=1000, stan=10000, hub=10000, myhome=10000
#DATA_GO_KR_LIMITS=tago=10000,seoul=1000

# (선택) 시연 프로파일: demo 로 두면 서버 용도(BUS·RESOLVE)가 DEMO 키를 먼저 쓴다
#DATA_GO_KR_PROFILE=demo

# --- 기본(호환) 키: 용도 키가 없거나 모두 한도에 닿았을 때만 쓴다 ----------------
DATA_GO_KR_KEY=

# --- V-World (지도 배경·경계·필지) ---------------------------------------------
VWORLD_KEY=
VWORLD_DOMAIN=

# 서울시 버스 API 도 같은 공공데이터포털 키를 쓴다(키마다 서울 서비스 활용신청이 따로 필요, 아직 미신청).
# 신청한 키에는 DATA_GO_KR_SERVICES_BUS_<N>=tago,seoul 로 표시한다.

# 주의: 변수 이름 앞에 NEXT_PUBLIC_ 을 붙이지 않는다(브라우저로 나간다).
# 캐시 위치(선택): CACHE_DIR=/path  (기본 로컬 .cache/, Vercel 은 os.tmpdir()/jt-cache)

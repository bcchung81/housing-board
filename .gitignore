# 인증키가 든 설정 파일 — 공개 저장소에 올리지 않음 (config.example.js를 복사해 사용)
config.js

# OS / 도구 부산물
.DS_Store
node_modules/
__pycache__/
*.pyc

# 대용량 원천 자료 (재다운로드 가능)
data/raw/lh/pamphlets/
data/raw/vworld/*.zip

# 기반시설 점검 원본(공공데이터포털에서 다시 내려받을 수 있음). 받는 방법은 README.md
data/raw/infra/*
!data/raw/infra/README.md

# 영상 렌더링 결과·캐시 (재생성 가능)
*.mp4
videos/*/renders/
videos/*/snapshots/
videos/*/.thumbnails/

# 개인 사진
docs/view/KakaoTalk_Photo_*

# 빌드 산출물
public/
!data/raw/lh/public/
.vercel
.env*

# 로컬 캐시(API 응답·키 사용량, 짧은 보관). lib/cache.js · lib/keys.js
.cache/

# 팀원 제출물·검증 결과·개발 환경·전달 패키지
input/
validation_out/
.venv/
dist/

# Next.js
.next/
next-env.d.ts
*.tsbuildinfo

# 시각 비교 스크린샷(재생성 가능)
.visual/

# 건축HUB 대용량 과거 판(월 약 6.5 MB × 20). 원본은 Storage ledger-raw 에 두고 저장소에는 manifest.json(sha256)만 둔다
schemas/*/raw/hub-bulk-history/*.zip

# HOME PoC 덤프(tools/ledger/home-dump.py)에서 뽑은 jsonl.gz. 원본은 Storage ledger-raw 에만 두고 저장소에는 manifest.json 만
schemas/*/raw/home/*/*.jsonl.gz

# HOME PoC 공개 API 스냅샷(덤프로 재현할 수 없는 값만 — tools/ledger/home-projects.js·home-sources.js --fetch-poc). 압축 원본은 git 무시, 같은 폴더 manifest.json(주소·받은 시각·sha256·행 수)만 커밋
schemas/*/raw/home-api/*/*.json.gz

# 열린 달 매일 갱신의 건축HUB OpenAPI 원본(법정동별 응답, tools/ledger/hub-api-refresh.js). 기획서 결정 4 "원천 응답 재배포 안 함" — Storage ledger-raw 에만(raw-store.js push --only raw/hub-refresh)
schemas/*/raw/hub-refresh/

# 단계별 전국 원천(2026-10-12 수집). 100 MB 넘는 대용량 zip 과 API 원본 응답(기획서 결정 4 "원천 응답 재배포 안 함")은 저장소에 manifest.json(sha256)만 둔다
schemas/*/raw/hub-bulk-ap/*.zip
schemas/*/raw/hub-bulk-bld/*.zip
schemas/*/raw/applyhome/*.json
schemas/*/raw/applyhome-cmpet/*.json
schemas/*/raw/vworld-district/*.geojson*
schemas/*/raw/kapt-list/*.json
schemas/*/raw/myhome-complex/*.json
schemas/*/raw/lh-lease-complex/*.json
schemas/*/raw/lh-public-complex/*.json
schemas/*/raw/lh-notice-detail/*.json
schemas/*/raw/hug-sale-history/*.json
!schemas/*/raw/*/manifest.json

# 발표 원천 조사 수집물(재생성 가능, 약 512MB — tools/research/chain) · 개인 사진 · sed 부산물(2026-10-19 체크포인트)
docs/speech/research/
docs/speech/KakaoTalk_Photo_*
*.css-E
